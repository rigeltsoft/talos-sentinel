# === Talos Sentinel Dashboard — configuración local / VPS ===
# Copia este archivo como .env y ajusta los valores.

# Base de datos MySQL (para local: ver DESPLIEGUE.md, se levanta con Docker/Podman)
DATABASE_URL=mysql://talos:talos123@localhost:3306/talos_dashboard

# --- Administrador inicial (login con correo + contraseña) ---
# Al arrancar, el servidor crea este admin si no existe.
# Si venías del modo LOCAL_AUTH_BYPASS, el usuario "local-dev" se MIGRA
# a este correo conservando su negocio. ¡Cambia la contraseña al entrar!
ADMIN_EMAIL=admin@talos.local
ADMIN_PASSWORD=admin123

# --- Sesión (JWT) ---
# APP_ID identifica la aplicación en el payload de la sesión.
APP_ID=local

# APP_SECRET firma la cookie de sesión (JWT HS256).
# En PRODUCCIÓN debe ser una clave aleatoria de al menos 32 caracteres:
#   openssl rand -hex 32
# (el servidor no arranca en producción con un secreto débil o corto)
APP_SECRET=local-secret-no-usado-en-login-local

# --- Firebase Cloud Messaging (web push: dashboard + app rider) ---
# Públicos (proyecto talos-sentinel). Solo cambia si usas otro proyecto.
VITE_FIREBASE_API_KEY=TU_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=talos-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talos-demo
VITE_FIREBASE_STORAGE_BUCKET=talos-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_VAPID_KEY=TU_VAPID_KEY

# --- Mapbox (mapa del domiciliario y geocodificación de direcciones) ---
# Token público pk.… de https://account.mapbox.com/access-tokens/
# Restríngelo por URL (localhost y tu dominio) antes de usarlo en producción.
VITE_MAPBOX_TOKEN=TU_TOKEN_PUBLICO_MAPBOX
